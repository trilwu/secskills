{
  "_about": "Maps MITRE ATT&CK techniques to the SecSkills skills that cover them. Consumed by the mapping-attack-techniques skill and by scripts/sync_attack.py, which generates the '## ATT&CK Coverage' section inside each mapped SKILL.md. Edit this file, then run: python3 scripts/sync_attack.py --write",
  "_accuracy": "Technique IDs and names are curated by hand and drift as ATT&CK releases new versions. scripts/sync_attack.py checks internal consistency only, not agreement with upstream. Re-verify against the current release at https://attack.mitre.org before relying on an ID in a report.",
  "_universal": {
    "note": "Every technique in this index is detectable and huntable. Rather than repeating them on every row, treat these as applying throughout.",
    "detection": "engineering-detections",
    "hunting": "hunting-threats",
    "response": "responding-to-incidents",
    "reporting": "reporting-security-findings"
  },
  "_unmapped": {
    "note": "Skills with no ATT&CK Enterprise mapping, and the framework that fits instead.",
    "securing-ai-systems": "MITRE ATLAS (AML.T####) and the OWASP Top 10 for LLM / Agentic Applications",
    "testing-mobile-applications": "ATT&CK Mobile matrix and OWASP MASVS — the Enterprise IDs do not apply",
    "exploiting-web3-smart-contracts": "No ATT&CK equivalent; use SWC registry and DASP classifications",
    "auditing-code-for-vulnerabilities": "Pre-attack. Use CWE and OWASP ASVS",
    "reviewing-code-changes": "Pre-attack. Use CWE",
    "reviewing-cryptography": "Pre-attack. Use CWE-310 family",
    "reporting-security-findings": "Process skill, not a technique",
    "mapping-attack-techniques": "Router over this index; it points at other skills rather than covering techniques itself",
    "producing-threat-intelligence": "CTI tradecraft; consumes and produces ATT&CK mappings via mapping-attack-techniques rather than covering techniques itself",
    "analyzing-go-binaries": "Procedure skill (Go pclntab recovery + GoReSym/redress). Tool-and-artifact scoped, not a technique",
    "analyzing-dotnet-assemblies": "Procedure skill (.NET IL + dnSpyEx/de4dot). Tool-and-artifact scoped, not a technique",
    "analyzing-rust-binaries": "Procedure skill (Rust demangling + rustfilt). Tool-and-artifact scoped, not a technique",
    "unpacking-protected-binaries": "Procedure skill (packers/protectors + x64dbg/Scylla/pe-sieve). Tool-and-artifact scoped, not a technique",
    "reversing-xamarin-maui": "Procedure skill (Xamarin/MAUI + pyxamstore). Tool-and-artifact scoped, not a technique",
    "bypassing-root-jailbreak-detection": "Procedure skill (root/jailbreak/Frida detection + Magisk/objection). Tool-and-artifact scoped, not a technique",
    "analyzing-ios-binaries": "Procedure skill (Mach-O/FairPlay + frida-ios-dump, class-dump). Tool-and-artifact scoped, not a technique",
    "testing-mobile-ipc": "Procedure skill (Android IPC and iOS URL schemes + drozer/adb). Tool-and-artifact scoped, not a technique",
    "bypassing-mobile-pinning": "Procedure skill (TLS interception + objection/Frida/SSL Kill Switch). Tool-and-artifact scoped, not a technique",
    "reversing-flutter-apps": "Procedure skill (Flutter/Dart + blutter). Tool-and-artifact scoped, not a technique",
    "reversing-react-native-apps": "Procedure skill (React Native/Hermes + hbctool). Tool-and-artifact scoped, not a technique",
    "reversing-obfuscated-javascript": "Reverse-engineering craft (JS deobfuscation, unbundling, sourcemap recovery). Not an Enterprise technique",
    "reversing-unity-il2cpp": "Procedure skill (Unity IL2CPP + Il2CppDumper). Tool-and-artifact scoped, not a technique",
    "analyzing-memory-images": "Procedure skill (RAM forensics + Volatility 3). Analysis method, not a technique",
    "investigating-m365-entra": "Procedure skill (M365/Entra cloud-log DFIR + UAL/sign-in logs). Investigation method, not a technique",
    "analyzing-linux-persistence": "Procedure skill (Linux persistence sweep, forensic). Analysis method covering many T1053/T1543/T1546 sub-techniques at once",
    "writing-sigma-rules": "Procedure skill (Sigma authoring + sigma-cli/pySigma). Detection-engineering craft, not a technique",
    "testing-ics-ot-protocols": "ATT&CK for ICS matrix (T0### series) and IEC 62443 — the Enterprise IDs do not apply",
    "analyzing-firmware-images": "Procedure skill (firmware extraction + binwalk/FirmAE). Tool-and-artifact scoped, not a technique",
